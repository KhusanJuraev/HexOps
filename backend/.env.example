# Copy to backend/.env and fill in. Never commit the real .env.
HEXOPS_DATABASE_URL=postgresql+psycopg://hexops:CHANGE_ME@127.0.0.1:5432/hexops
# Used only by the test suite; it is wiped on every test run.
HEXOPS_TEST_DATABASE_URL=postgresql+psycopg://hexops:CHANGE_ME@127.0.0.1:5432/hexops_test
# Used only by the browser (Playwright) tests; also wiped on every run. Optional.
HEXOPS_E2E_DATABASE_URL=postgresql+psycopg://hexops:CHANGE_ME@127.0.0.1:5432/hexops_e2e
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
HEXOPS_SECRET_KEY=CHANGE_ME

# Network binding. Loopback only by default.
# HEXOPS_HOST=127.0.0.1
# HEXOPS_PORT=8000
# Binding to a non-loopback address (LAN exposure) also requires:
# HEXOPS_ALLOW_LAN=true
# Set to true whenever HexOps is served over HTTPS (required for LAN exposure).
# HEXOPS_COOKIE_SECURE=false

# Host names the API answers to (comma separated, no ports). Anything else gets
# 400 invalid_host (DNS-rebinding defence). Add your HTTPS proxy's name for LAN use.
# HEXOPS_ALLOWED_HOSTS=127.0.0.1,localhost,::1

# Extra trusted origins for state-changing requests (comma separated).
# HEXOPS_TRUSTED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:4173,http://localhost:4173

# Session lifetime
# HEXOPS_SESSION_TTL_HOURS=168
# HEXOPS_SESSION_IDLE_HOURS=24

# Expose /api/docs (OpenAPI UI). Off by default.
# HEXOPS_ENABLE_DOCS=false
# PDF export/import (Stage 7). Job files are private and deleted when results expire.
# HEXOPS_PDF_DIR=../data/pdf-jobs
# HEXOPS_PDF_IMPORT_MAX_BYTES=20971520
# HEXOPS_PDF_IMPORT_MAX_PAGES=200
# HEXOPS_PDF_RESULT_TTL_MINUTES=60
# HEXOPS_PDF_JOB_TIMEOUT_SECONDS=120
# Full export/import (Settings → Data). Working files are private and short-lived;
# pre-import backups are kept in HEXOPS_BACKUPS_DIR.
# HEXOPS_TRANSFER_DIR=../data/transfer
# HEXOPS_BACKUPS_DIR=../data/backups
# HEXOPS_TRANSFER_MAX_ARCHIVE_BYTES=2147483648
# HEXOPS_TRANSFER_MAX_UNPACKED_BYTES=8589934592
# HEXOPS_TRANSFER_MAX_ENTRIES=200000
